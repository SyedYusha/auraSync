# AuraSync+ AI Provider Router
# Keep ALL provider keys server-side. Never put these in EXPO_PUBLIC_* variables.
AI_PROVIDER_ORDER=openai,gemini,deepseek

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

PORT=3001
WEB_ORIGIN=https://aura-sync-rouge.vercel.app

# App client (Expo inlines EXPO_PUBLIC_* vars at bundle time)
# For physical devices: set to your PC LAN IP, e.g. http://192.168.1.5:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase (optional — leave empty to run with local demo auth backed by AsyncStorage)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side authorization for protected Gym Intelligence AI requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=
