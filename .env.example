# AuraSync+ AI Coach Server
# Copy this file to .env and fill in your API key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
PORT=3001

# App client (Expo inlines EXPO_PUBLIC_* vars at bundle time)
# For physical devices: set to your PC LAN IP, e.g. http://192.168.1.5:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase (optional — leave empty to run with local demo auth backed by AsyncStorage)
# Create a project at https://supabase.com, then copy the Project URL + anon public key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side authorization for protected Gym Intelligence AI requests.
# Use the same project URL and anon key; never add a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
